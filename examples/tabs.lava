# Tab-indented Fibonacci calculator in Lava (\t indentation)

public class Tabs:
	static def fib(n: i32) -> i64:
		if n <= 1:
			return i64(n)
		a: i64 = 0
		b: i64 = 1
		for i in range(2, n + 1):
			next: i64 = a + b
			a = b
			b = next
		return b

	public static def main(args: str[]):
		fibs: i64[10] = [fib(k) for k in range(10)]
		for k in range(10):
			println(f"fib({k}) = {fibs[k]}")
