# Minimal introduction to Lava types, comprehensions, functions, and loops

public class Hello:
    MAX_GREETINGS = 3

    static def greet(name: str, count: i32) -> i32:
        if name == nil or name.isEmpty() or count <= 0:
            return 0
        steps: i32[MAX_GREETINGS] = [i + 1 for i in range(MAX_GREETINGS)]
        for i in range(count):
            println(f"[{steps[i]}] Hello from Lava, {name}!")
        return count

    public static def main(args: str[]):
        sent: i32 = greet("World", MAX_GREETINGS)
        if sent > 0 and not (sent > 10):
            println(f"Successfully sent {sent} greetings.")
